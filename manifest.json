{
  "manifest_version": 3,
  "name": "文章链接速读",
  "version": "0.2.0",
  "description": "解读 GitHub、X 长文和公开博客，先看中文结论，再决定是否深入。",
  "permissions": ["activeTab", "scripting", "storage", "tabs"],
  "host_permissions": [
    "https://api.github.com/*",
    "https://raw.githubusercontent.com/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "解读当前链接",
    "default_popup": "src/popup.html"
  },
  "options_page": "src/options.html",
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "打开文章链接速读"
    }
  }
}
